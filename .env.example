# Team B Ranking Engine — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env for local development.
# NEVER commit .env to version control.
#
# On Render: set these in the Environment tab of your Web Service.

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the server listens on. Render provides this automatically.
PORT=8080

# ─── Team C Integration ──────────────────────────────────────────────────────
# Base URL of Team C's deployed backend (no trailing slash).
TEAM_C_BASE_URL=https://rit-placement-team-c-backend.onrender.com

# ─ HTTP timeout for calls to Team C (seconds).
TEAM_C_TIMEOUT_SECONDS=30

# Bearer token required by Team C's authenticated POST endpoints.
# Obtain from Team C. Set this in the Render environment tab — never commit the real value here.
TEAM_C_WRITE_TOKEN=

# ─── Ranking Write-back ───────────────────────────────────────────────────────
# Set to true once Team C confirms POST /internal/v1/drive-rankings is live.
# DO NOT set to true until Team C confirms the endpoint is live.
TEAM_B_RANKING_WRITE_ENABLED=false

# URL for ranking write-back — Team C's confirmed internal endpoint path.
TEAM_B_RANKING_WRITE_URL=https://rit-placement-team-c-backend.onrender.com/internal/v1/drive-rankings
